# Labeling tool Supabase demo configuration
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Optional: point dashboard/alerts/leads/reports to a self-hosted Supabase/VPS source.
NEXT_PUBLIC_VPS_SUPABASE_URL=https://<your-vps-supabase-host>
NEXT_PUBLIC_VPS_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Optional: set to /supabase-config.json to load public demo config from a static file
# NEXT_PUBLIC_SUPABASE_CONFIG_PATH=/supabase-config.json

# Backend API server used by Next.js API proxy routes
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=<emailjs-service-id>
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=<default-emailjs-template-id>
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=<emailjs-public-key>
# Optional: use separate templates for each consultation email.
# If omitted, the default template above is used for all three email types.
# EMAILJS_CONSULTATION_RECEIVED_TEMPLATE_ID=<received-template-id>
# EMAILJS_CONSULTATION_APPROVED_TEMPLATE_ID=<approved-template-id>
# EMAILJS_CONSULTATION_REJECTED_TEMPLATE_ID=<rejected-template-id>
# EMAILJS_PRIVATE_KEY=<emailjs-private-key>

